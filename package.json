{
  "name": "veilarbvedtaksstottefs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --mode demo",
    "build": "tsc && vite build --base=https://cdn.nav.no/obo/prod/veilarbvedtaksstottefs/dist",
    "build:dev": "tsc && vite build --base=https://cdn.nav.no/obo/dev/veilarbvedtaksstottefs/dist",
    "build:mock": "tsc && vite build --mode demo --base=/veilarbvedtaksstottefs/",
    "lint": "oxlint src",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prettier:check": "prettier --check src --config .prettierrc.json",
    "prettier:write": "prettier --write src --config .prettierrc.json",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@navikt/aksel-icons": "8.19.2",
    "@navikt/arbeidssokerregisteret-utils": "3.0.1",
    "@navikt/ds-css": "8.19.2",
    "@navikt/ds-react": "8.19.2",
    "@navikt/fnrvalidator": "2.2.1",
    "@navikt/navspa": "7.5.0",
    "axios": "1.20.0",
    "classnames": "2.5.1",
    "constate": "4.0.0",
    "dayjs": "1.11.23",
    "dompurify": "3.4.17",
    "lodash.debounce": "4.0.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "11.0.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@navikt/aksel-stylelint": "8.19.2",
    "@types/lodash.debounce": "4.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "husky": "9.1.7",
    "less": "4.9.1",
    "lint-staged": "17.6.0",
    "msw": "3.0.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "src/**/*.css": [
      "stylelint"
    ],
    "src/**/*.{json,less,md}": [
      "prettier --write"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "oxlint"
    ]
  },
  "msw": {
    "workerDirectory": "public"
  },
  "stylelint": {
    "extends": "@navikt/aksel-stylelint/recommended"
  }
}
